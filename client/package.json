{
	"name": "client",
	"version": "0.0.71",
	"license": "MIT OR Apache-2.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "tsc --noEmit",
		"test:unit": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"lint": "oxfmt --check . && oxlint . --max-warnings=0",
		"lint:fix": "oxfmt --write . && oxlint . --max-warnings=0 --fix",
		"format": "oxfmt --write .",
		"mcp": "vite-node mcp/server.ts",
		"gen:docs": "vite-node scripts/gen-widget-docs.ts",
		"check:docs": "vite-node scripts/gen-widget-docs.ts --check",
		"gen:shots": "node scripts/screenshots.mjs",
		"gen:presets": "node scripts/screenshots.mjs --presets",
		"gen:gallery": "npm run gen:shots && npm run gen:docs"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/coverage-v8": "^5.0.5",
		"happy-dom": "^21.0.4",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"tslib": "^2.8.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vite-node": "^6.0.0",
		"vitest": "^5.0.5"
	},
	"type": "module",
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/language": "^6.13.1",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
		"@lezer/common": "^1.5.4",
		"@lezer/highlight": "^1.2.5",
		"@tauri-apps/api": "^2.12.4",
		"downshift": "^9.4.0",
		"ical.js": "^2.2.1",
		"quickjs-emscripten-core": "^0.32.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	}
}
